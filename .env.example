EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key
# Auth redirect URLs must allow query params used as a one-time callback state:
# onemorething://auth/callback
# onemorething://auth/callback?state=*
# Optional alias used by some Supabase dashboards:
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Never put the service_role key in this app. EAS production builds
# should receive the two EXPO_PUBLIC_SUPABASE_* values as secrets.
