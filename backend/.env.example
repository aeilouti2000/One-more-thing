NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://omt:omt@localhost:5432/omt
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=90
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,http://127.0.0.1:8081,http://127.0.0.1:8082
DATABASE_SSL=false
APP_MIN_VERSION=
APP_DOWNLOAD_URL=
# Newest version; older installs get an optional "Update" prompt.
APP_LATEST_VERSION=
# OAuth Web client ID (comma-separate several). Empty disables Google sign-in.
GOOGLE_CLIENT_ID=
# Brevo transactional email. Without a key, codes are logged (dev only).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=One More Thing
