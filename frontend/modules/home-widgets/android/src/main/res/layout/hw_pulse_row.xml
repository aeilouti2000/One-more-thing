<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/hw_row" android:layout_width="match_parent" android:layout_height="34dp"
  android:orientation="horizontal" android:gravity="center_vertical">
  <FrameLayout android:layout_width="22dp" android:layout_height="22dp">
    <ImageView android:id="@+id/hw_avatar_bg" android:layout_width="match_parent" android:layout_height="match_parent"
      android:src="@drawable/hw_circle" android:importantForAccessibility="no" />
    <TextView android:id="@+id/hw_avatar_text" style="@style/HwText.Strong" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:layout_gravity="center" android:textAlignment="center"
      android:maxLines="1" android:textSize="11sp" android:textColor="#FFFFFFFF" />
  </FrameLayout>
  <TextView android:id="@+id/hw_row_name" style="@style/HwText" android:layout_width="0dp" android:layout_weight="1"
    android:layout_height="wrap_content" android:layout_marginStart="9dp" android:maxLines="1" android:ellipsize="end"
    android:textSize="13sp" />
  <TextView android:id="@+id/hw_row_detail" style="@style/HwText" android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:textSize="11sp"
    android:textColor="@color/hw_d_muted" />
</LinearLayout>
