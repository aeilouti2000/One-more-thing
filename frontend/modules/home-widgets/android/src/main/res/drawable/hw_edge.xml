<?xml version="1.0" encoding="utf-8"?>
<!-- The rim of a glass widget: light catching the top, and a thin bright outline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient android:angle="270" android:startColor="#24FFFFFF" android:centerColor="#00FFFFFF"
        android:endColor="#00FFFFFF" android:centerY="0.35" />
      <corners android:radius="@dimen/hw_radius" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#00000000" />
      <stroke android:width="1dp" android:color="#42FFFFFF" />
      <corners android:radius="@dimen/hw_radius" />
    </shape>
  </item>
</layer-list>
