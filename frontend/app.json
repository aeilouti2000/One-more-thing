{
  "expo": {
    "name": "One More Thing",
    "slug": "one-more-thing",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onemorething",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.onemorething.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#071633",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#071633",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#071633"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#2196F3",
          "defaultChannel": "list-updates"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "032259aa-71eb-4c1b-84e6-99746722e0de"
      }
    },
    "owner": "ahmadaylouti"
  }
}
