{
  "expo": {
    "name": "One More Thing",
    "slug": "one-more-thing",
    "version": "2.1.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onemorething",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.onemorething.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 33,
      "adaptiveIcon": {
        "backgroundColor": "#071633",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#071633",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#071633"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#2196F3",
          "defaultChannel": "list-updates"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "One More Thing reads a receipt photo on this phone to fill prices. The photo is not uploaded.",
          "cameraPermission": "One More Thing uses the camera to read a receipt on this phone. The photo is not uploaded.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "131e810b-71fa-4bab-87fc-a4e2f28c8595"
      }
    },
    "owner": "ahmadayloutis-team"
  }
}
