{
  "expo": {
    "name": "One More Thing",
    "slug": "one-more-thing",
    "version": "2.4.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onemorething",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.onemorething.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 43,
      "adaptiveIcon": {
        "backgroundColor": "#071633",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#071633",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#071633"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#2196F3",
          "defaultChannel": "list-updates"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "One More Thing uses your photos to add a picture to an item for your household, or to read a receipt on this phone (receipt photos are not uploaded).",
          "cameraPermission": "One More Thing uses the camera to add a picture to an item for your household, or to read a receipt on this phone (receipt photos are not uploaded).",
          "microphonePermission": false
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "032259aa-71eb-4c1b-84e6-99746722e0de"
      }
    },
    "owner": "ahmadaylouti"
  }
}
